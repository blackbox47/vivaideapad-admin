# Copy this file to .env.localdev for per-developer overrides (pnpm dev:local),
# or reference it when adding new variables to .env.develop / .env.prod.
#
# Required variables:
VITE_API_BASE_URL=

# Optional: serve RTK Query endpoints from src/services/mock instead of HTTP.
# Defaults to true outside the prod mode.
VITE_USE_MOCK_API=
